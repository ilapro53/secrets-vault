#!/usr/bin/env python3
# secrets-verify <cmd> <code> — exit 0 if valid, 1 if invalid
# Code can be XXXXXX (6 digits) or XXXXXX-YYYYYY (current-next).
# Checks each code against ±1 window. If either is valid → OK.
import sys, os, hmac, hashlib, time, struct

secret_file = "/root/.secrets-otp/totp-secret"
if not os.path.isfile(secret_file):
    print("ERROR: secret not found", file=sys.stderr)
    sys.exit(2)

if len(sys.argv) < 3:
    print("ERROR: usage: secrets-verify <cmd> <code>", file=sys.stderr)
    sys.exit(2)

cmd = sys.argv[1]
code_input = sys.argv[2]

if not cmd or not code_input:
    print("ERROR: empty cmd or code", file=sys.stderr)
    sys.exit(2)

# Parse codes: accept XXXXXX or XXXXXX-YYYYYY
code_parts = code_input.split("-")
codes_to_check = []
for part in code_parts:
    part = part.strip()
    if len(part) == 6 and part.isdigit():
        codes_to_check.append(part)
    else:
        print(f"ERROR: invalid code part '{part}' (must be 6 digits)", file=sys.stderr)
        sys.exit(2)

if not codes_to_check:
    print("ERROR: no valid codes provided", file=sys.stderr)
    sys.exit(2)

with open(secret_file) as f:
    b32secret = f.read().strip()

if not b32secret:
    print("ERROR: empty secret", file=sys.stderr)
    sys.exit(2)

def b32decode(s):
    b32 = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"
    s = s.upper().strip()
    bits = "".join(format(b32.index(c), "05b") for c in s if c in b32)
    return bytes(int(bits[i*8:(i+1)*8], 2) for i in range(len(bits)//8))

key = b32decode(b32secret)

def gen_code(cmd, tw):
    msg = f"{cmd}|{tw}"
    h = hmac.new(key, msg.encode(), hashlib.sha1).digest()
    off = h[-1] & 0xf
    p = struct.unpack(">I", h[off:off+4])[0] & 0x7fffffff
    return f"{p % 1000000:06d}"

now = int(time.time())
# Generate all expected codes: ±1 window for 5-min intervals
expected_codes = set()
for offset in [0, -1, 1]:
    tw = now // 300 + offset
    expected_codes.add(gen_code(cmd, tw))
    # Also add the next-window code (for combined format)
    expected_codes.add(gen_code(cmd, tw + 1))
    # And prev-window pair partner
    expected_codes.add(gen_code(cmd, tw - 1))

# Check if ANY of the submitted codes matches ANY expected code
for submitted in codes_to_check:
    if submitted in expected_codes:
        print("OK")
        sys.exit(0)

print("INVALID", file=sys.stderr)
sys.exit(1)
