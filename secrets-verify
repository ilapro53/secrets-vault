#!/usr/bin/env python3
# secrets-verify <cmd> <code> — exit 0 if valid, 1 if invalid
# Checks ±1 window (10min windows = 30min validity window)
import sys, os, hmac, hashlib, time, struct

secret_file = "/root/.secrets-otp/totp-secret"
if not os.path.isfile(secret_file):
    print("ERROR: secret not found", file=sys.stderr)
    sys.exit(2)

if len(sys.argv) < 3:
    print("ERROR: usage: secrets-verify <cmd> <code>", file=sys.stderr)
    sys.exit(2)

cmd = sys.argv[1]
code = sys.argv[2]

if not cmd or not code:
    print("ERROR: empty cmd or code", file=sys.stderr)
    sys.exit(2)

if not code.isdigit() or len(code) != 6:
    print("ERROR: code must be 6 digits", file=sys.stderr)
    sys.exit(2)

with open(secret_file) as f:
    b32secret = f.read().strip()

if not b32secret:
    print("ERROR: empty secret", file=sys.stderr)
    sys.exit(2)

def b32decode(s):
    b32 = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"
    s = s.upper().strip()
    bits = "".join(format(b32.index(c), "05b") for c in s if c in b32)
    return bytes(int(bits[i*8:(i+1)*8], 2) for i in range(len(bits)//8))

key = b32decode(b32secret)

def gen_code(cmd, tw):
    msg = f"{cmd}|{tw}"
    h = hmac.new(key, msg.encode(), hashlib.sha1).digest()
    off = h[-1] & 0xf
    p = struct.unpack(">I", h[off:off+4])[0] & 0x7fffffff
    return f"{p % 1000000:06d}"

now = int(time.time())
for offset in [0, -1, 1]:
    tw = now // 600 + offset
    expected = gen_code(cmd, tw)
    if expected == code:
        print("OK")
        sys.exit(0)

print("INVALID", file=sys.stderr)
sys.exit(1)
