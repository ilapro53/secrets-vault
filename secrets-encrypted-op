#!/usr/bin/env python3
"""secrets-encrypted-op — выполнить зашифрованную операцию с секретами.

Usage:
  secrets-encrypted-op SECRET_<hex>

Agent получает от пользователя SECRET_<hex>, запускает эту команду.
Скрипт расшифровывает, проверяет OTP, выполняет операцию.
Значение секрета НИКОГДА не выводится в stdout/stderr.

Операции:
  set_secret <name> <otp6>
    <value>
    → pass insert -f <name> с <value>
  
  delete_secret <name> <otp6>
    → pass rm -f <name>

Формат шифрования:
  - IV (16 bytes) + ciphertext (AES-128-CBC)
  - Ключ: первые 16 байт raw-ключа TOTP
  - ОTP встроенный: HMAC-SHA1(command, timeWindow)
    где command = "encrypted_<op> <name>"
    проверяется ±1 окно (5 мин)
"""

import os, sys, hmac, hashlib, time, struct, subprocess

SECRET_FILE = "/root/.secrets-otp/totp-secret"

# pass принадлежит пользователю, не root. Читаем из /root/.secrets-otp/real-user
_REAL_USER = "user"  # fallback
try:
    with open("/root/.secrets-otp/real-user") as f:
        _REAL_USER = f.read().strip()
except:
    pass


# ── TOTP helpers (reused from secrets-verify) ───────────────────────────────

def b32decode(s):
    b32 = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"
    s = s.upper().strip()
    bits = "".join(format(b32.index(c), "05b") for c in s if c in b32)
    return bytes(int(bits[i*8:(i+1)*8], 2) for i in range(len(bits)//8))


def gen_otp(key, cmd, tw):
    msg = f"{cmd}|{tw}"
    h = hmac.new(key, msg.encode(), hashlib.sha1).digest()
    off = h[-1] & 0xf
    p = struct.unpack(">I", h[off:off+4])[0] & 0x7fffffff
    return f"{p % 1000000:06d}"


def verify_otp(key, cmd, code_input):
    """Check 6-digit code against ±1 time window (5 min = 300s)."""
    if not (len(code_input) == 6 and code_input.isdigit()):
        return False
    now = int(time.time())
    for offset in (0, -1, 1):
        tw = now // 300 + offset
        if gen_otp(key, cmd, tw) == code_input:
            return True
        if gen_otp(key, cmd, tw + 1) == code_input:
            return True
        if gen_otp(key, cmd, tw - 1) == code_input:
            return True
    return False


# ── AES-128-CBC decryption via openssl ─────────────────────────────────────

def aes_decrypt(key16, iv, ciphertext):
    """Decrypt AES-128-CBC using openssl CLI. Returns plaintext bytes."""
    hex_key = key16.hex()
    hex_iv = iv.hex()
    proc = subprocess.run(
        ["openssl", "enc", "-aes-128-cbc", "-d",
         "-K", hex_key, "-iv", hex_iv],
        input=ciphertext,
        capture_output=True
    )
    if proc.returncode != 0:
        raise ValueError("Decryption failed: " + proc.stderr.decode(errors="replace"))
    return proc.stdout


# ── Pass helpers ────────────────────────────────────────────────────────────

def _sudo_user(args, input_data=None):
    """Run a command as the real user via sudo -u (passwordless via sudoers)."""
    if os.geteuid() == 0 and _REAL_USER != "root":
        cmd = ["sudo", "-u", _REAL_USER] + args
    else:
        cmd = args
    proc = subprocess.run(cmd, input=input_data, capture_output=True)
    if proc.returncode != 0:
        err = proc.stderr.decode(errors="replace").strip()
        raise RuntimeError(f"{' '.join(args)} failed: {err}")
    return proc


def pass_set(name, value):
    """Set a pass secret."""
    _sudo_user(["pass", "insert", "-m", "-f", name], input_data=value.encode())
    return True


def pass_delete(name):
    """Delete a pass secret."""
    _sudo_user(["pass", "rm", "-f", name])
    return True


# ── Main ────────────────────────────────────────────────────────────────────

def die(msg):
    print(f"❌ {msg}", file=sys.stderr)
    sys.exit(1)


def ok(msg):
    print(f"✅ {msg}")


def main():
    # ── Check args ──
    if len(sys.argv) < 2:
        die("Usage: secrets-encrypted-op SECRET_<hex>")
    
    payload = sys.argv[1].strip()
    if not payload.startswith("SECRET_"):
        die("Payload must start with SECRET_")
    
    hex_data = payload[len("SECRET_"):]
    if len(hex_data) < 32:  # minimum: 16 bytes IV
        die("Payload too short")
    
    try:
        raw = bytes.fromhex(hex_data)
    except ValueError:
        die("Payload is not valid hex")
    
    # ── Read TOTP secret ──
    if not os.path.isfile(SECRET_FILE):
        die(f"TOTP secret not found ({SECRET_FILE})")
    
    with open(SECRET_FILE) as f:
        b32secret = f.read().strip()
    
    if not b32secret:
        die("TOTP secret is empty")
    
    totp_key = b32decode(b32secret)  # full 20-byte key
    aes_key = totp_key[:16]          # first 16 bytes for AES-128
    
    # ── Decrypt ──
    iv = raw[:16]
    ciphertext = raw[16:]
    
    try:
        plaintext = aes_decrypt(aes_key, iv, ciphertext)
    except ValueError as e:
        die(str(e))
    
    # ── Parse plaintext ──
    # Format: <op> <name> <otp6>\n<value>
    # or:     <op> <name> <otp6> (for delete)
    text = plaintext.decode("utf-8", errors="replace")
    lines = text.split("\n", 1)
    first_line = lines[0].strip()
    
    parts = first_line.split(None, 3)  # at most 4 parts
    if len(parts) < 3:
        die("Invalid payload format: expected '<op> <name> <otp>'")
    
    op = parts[0]
    name = parts[1]
    otp = parts[2]
    value = lines[1] if len(lines) > 1 else ""
    
    ALLOWED_OPS = {"set_secret", "delete_secret"}
    if op not in ALLOWED_OPS:
        die(f"Unknown operation '{op}'. Allowed: {', '.join(sorted(ALLOWED_OPS))}")
    
    # Validate secret name (prevent path traversal)
    if not name or "/.." in name or name.startswith(".."):
        die(f"Invalid secret name '{name}'")
    if not all(c.isalnum() or c in "/._-" for c in name):
        die(f"Invalid characters in secret name '{name}'")
    
    # ── Verify embedded OTP ──
    otp_cmd = f"encrypted_{op} {name}"
    if not verify_otp(totp_key, otp_cmd, otp):
        die(f"OTP verification failed for '{otp_cmd}'. Code expired or wrong.")
    
    # ── Execute operation ──
    try:
        if op == "set_secret":
            if not value:
                die("set_secret requires a value")
            pass_set(name, value)
            ok(f"set_secret {name}: ok")
        elif op == "delete_secret":
            pass_delete(name)
            ok(f"delete_secret {name}: ok")
    except RuntimeError as e:
        die(str(e))
    
    # ── NEVER print the secret value ──
    # (We don't even pass it through variables that persist)


if __name__ == "__main__":
    main()
