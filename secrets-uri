#!/usr/bin/env bash
# Secrets Vault provisioning URI — only for setup/recovery
# Usage: sudo ./secrets-uri   (shows URI + QR)
# This file lives outside sudoers — requires sudo password.
set -euo pipefail
SECRET_FILE="/root/.secrets-otp/totp-secret"
[ -f "$SECRET_FILE" ] || { echo "ERROR: secret not found" >&2; exit 1; }
SECRET=$(cat "$SECRET_FILE")
URI="otpauth://totp/Secrets-Vault?secret=${SECRET}&issuer=MyClaw"
echo "$URI"
if command -v qrencode &>/dev/null; then
    echo "---"
    echo "$URI" | qrencode -t UTF8
fi
