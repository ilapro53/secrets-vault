#!/bin/bash
# secrets-bash-executor — OTP-gated bash executor with secret injection
# Usage: secrets-bash-executor --secrets VAR1,VAR2 --code XXXXXX-XXXXXX - <<'SCRIPT'
#   ... script body ...
# SCRIPT
#
# 1. Reads TOTP secret (sudo /root/.secrets-otp/totp-secret)
# 2. Reads heredoc stdin into a temp file
# 3. Calls Python core for OTP check + secret injection + execution
set -euo pipefail

# ── Parse args ──
ALL_ARGS=("$@")
SEKRETS=""
CODE=""
PY_ARGS=()

while [ $# -gt 0 ]; do
    case "$1" in
        --secrets) SEKRETS="$2"; PY_ARGS+=("--secrets" "$2"); shift 2 ;;
        --code)    CODE="$2";    PY_ARGS+=("--code" "$2");    shift 2 ;;
        --)        PY_ARGS+=("$@"); break ;;
        *)         PY_ARGS+=("$1"); shift ;;
    esac
done

if [ -z "$SEKRETS" ]; then
    echo "Usage: secrets-bash-executor --secrets VAR1,VAR2 --code XXXXXX-XXXXXX - <<'SCRIPT'" >&2
    exit 1
fi

# ── Read TOTP secret (sudoers should allow passwordless) ──
TOTP_SECRET=$(sudo -n cat /root/.secrets-otp/totp-secret 2>/dev/null || \
              sudo  cat /root/.secrets-otp/totp-secret 2>/dev/null || true)

if [ -z "$TOTP_SECRET" ]; then
    echo "❌ Cannot read TOTP secret (/root/.secrets-otp/totp-secret)" >&2
    echo "   TOTP not initialized? Run: sudo ./setup-secrets.sh" >&2
    exit 2
fi

# ── Read heredoc stdin into a temp file ──
SCR_BODY=$(cat) || true
if [ -z "$SCR_BODY" ]; then
    echo "❌ No script body received (stdin is empty)" >&2
    exit 1
fi

SCR_BODY_FILE=$(mktemp /tmp/sbe-XXXXXX)
trap 'rm -f "$SCR_BODY_FILE"' EXIT
printf '%s\n' "$SCR_BODY" > "$SCR_BODY_FILE"

# ── Run the Python core ──
export TOTP_SECRET SCR_BODY_FILE
exec python3 "$(dirname "$0")/.secrets-bash-executor-core.py" "${PY_ARGS[@]}"
