#!/usr/bin/env python3
"""secrets-bash-executor — OTP-gated script executor with secret injection.

Usage:
  secrets-bash-executor --secrets VAR1,VAR2 --code XXXXXX-XXXXXX - <<'SCRIPT'
  # script body using $VAR1, $VAR2
  SCRIPT

Flow:
  1. Agent sends a heredoc command to user
  2. User pastes the ENTIRE command (from "secrets-bash-executor" to "SCRIPT")
     into the Secrets Vault HTML app on their phone
  3. App computes HMAC(secret, full_text|time/300) → shows 6-digit codes (XXXXXX-XXXXXX)
  4. User tells agent the codes
  5. Agent runs the same command with --code XXXXXX-XXXXXX added
  6. This script reconstructs the original full text (without --code),
     verifies the OTP code, exports secrets from pass, and executes the script

Security:
  - Code is bound to the full script text (any change invalidates it)
  - Agent never sees the secret values — they're exported as env vars and
    used directly by the script
  - 5-minute time window with ±1 window tolerance
"""
import sys, os, hmac, hashlib, time, struct, subprocess

SECRET_FILE = "/root/.secrets-otp/totp-secret"


def b32decode(s):
    """Decode base32 string to bytes."""
    b32 = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"
    s = s.upper().strip()
    bits = "".join(format(b32.index(c), "05b") for c in s if c in b32)
    return bytes(int(bits[i*8:(i+1)*8], 2) for i in range(len(bits)//8))


def gen_code(key, msg, tw):
    """Generate a 6-digit OTP code for a given message and time window."""
    text = f"{msg}|{tw}"
    h = hmac.new(key, text.encode(), hashlib.sha1).digest()
    off = h[-1] & 0xf
    p = struct.unpack(">I", h[off:off+4])[0] & 0x7fffffff
    return f"{p % 1000000:06d}"


def verify_code(key, msg, code_input):
    """Check if any submitted code part matches any valid window (±1)."""
    code_parts = code_input.split("-")
    codes_to_check = [
        p.strip() for p in code_parts
        if len(p.strip()) == 6 and p.strip().isdigit()
    ]
    if not codes_to_check:
        return False

    now = int(time.time())
    expected = set()
    for offset in [0, -1, 1]:
        tw = now // 300 + offset
        expected.add(gen_code(key, msg, tw))
        expected.add(gen_code(key, msg, tw + 1))
        expected.add(gen_code(key, msg, tw - 1))

    return any(c in expected for c in codes_to_check)


def main():
    args = sys.argv[1:]

    # Parse options
    secrets_list = None
    code = None

    i = 0
    while i < len(args):
        if args[i] == "--secrets" and i + 1 < len(args):
            secrets_list = args[i + 1]
            i += 2
        elif args[i] == "--code" and i + 1 < len(args):
            code = args[i + 1]
            i += 2
        else:
            i += 1

    if not secrets_list:
        print("Usage: secrets-bash-executor --secrets VAR1,VAR2 --code XXXXXX-XXXXXX - <<'SCRIPT'",
              file=sys.stderr)
        print("  ... (script using $VAR1, $VAR2)", file=sys.stderr)
        print("  SCRIPT", file=sys.stderr)
        sys.exit(1)

    if not os.path.isfile(SECRET_FILE):
        print(f"ERROR: secret not found at {SECRET_FILE}", file=sys.stderr)
        sys.exit(2)

    with open(SECRET_FILE) as f:
        b32secret = f.read().strip()

    key = b32decode(b32secret)

    # Read stdin (script body between heredoc markers)
    stdin_body = sys.stdin.read()

    # Reconstruct the arg line WITHOUT the --code part
    arg_parts = []
    si = 0
    while si < len(args):
        if args[si] == "--code":
            si += 2  # skip both --code and its value
        else:
            arg_parts.append(args[si])
            si += 1

    exec_name = os.path.basename(sys.argv[0])
    header_line = f"{exec_name} {' '.join(arg_parts)}"

    # Reconstruct the EXACT text that user pasted into the HTML app.
    # In bash heredoc: cmd <<'SCRIPT'\n<body>\nSCRIPT
    # stdin_body includes trailing \n from the body, so:
    #   full_text = header + " <<'SCRIPT'\n" + stdin_body + "SCRIPT"
    full_text = f"{header_line} <<'SCRIPT'\n{stdin_body}SCRIPT"

    # Normalize trailing whitespace for matching
    full_text = full_text.rstrip()

    # ─── OTP Verification ──────────────────────────────────────────────
    if not code:
        print("ERROR: --code XXXXXX-XXXXXX is required. Ask user to generate it.",
              file=sys.stderr)
        sys.exit(1)

    if not verify_code(key, full_text, code):
        print(f"❌ ACCESS DENIED: wrong or expired code", file=sys.stderr)
        sys.exit(1)

    print(f"✅ CODE VERIFIED", file=sys.stderr)

    # ─── Export secrets from pass ──────────────────────────────────────
    secret_vars = [v.strip() for v in secrets_list.split(",") if v.strip()]
    for var in secret_vars:
        result = subprocess.run(
            ["pass", "show", var],
            capture_output=True, text=True
        )
        if result.returncode != 0:
            print(f"❌ Secret '{var}' not found in pass", file=sys.stderr)
            print(f"   Add it: pass insert {var}", file=sys.stderr)
            sys.exit(1)
        value = result.stdout.strip().split('\n')[0]
        os.environ[var] = value
        print(f"  → ${var} loaded from pass", file=sys.stderr)

    # ─── Execute the script ────────────────────────────────────────────
    proc = subprocess.run(
        ["bash"],
        input=stdin_body,
        text=True
    )
    sys.exit(proc.returncode)


if __name__ == "__main__":
    main()
