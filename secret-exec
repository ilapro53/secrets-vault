#!/usr/bin/env bash
# secret-exec — securely execute commands with OTP-gated secrets
# Usage:
#   secret-exec --code <6-digit> <secret-name> -- <command...>
#
# Flow:
#   1. Agent requests access to, say, SSH_KEY
#   2. You open vault app on phone → type "SSH_KEY" → get 482719
#   3. You tell agent the code
#   4. Agent runs: secret-exec --code 482719 SSH_KEY -- ssh-add -
#   5. System verifies the code against HMAC(secret, "SSH_KEY"|time)
#   6. Only on match: secret is piped to the command
set -euo pipefail

CODE=""
AUTO_APPROVE=false

# Parse options
while [ $# -gt 0 ]; do
    case "$1" in
        --code) shift; CODE="${1:-}"; shift ;;
        --approve) AUTO_APPROVE=true; shift ;;  # skip OTP check (for testing/trusted cmds)
        --) shift; break ;;
        *) break ;;
    esac
done

STORE_PATH="${1:-}"
shift 2>/dev/null || true

[ -n "$STORE_PATH" ] || {
    echo "Usage: secret-exec [--code <6-digit>] <secret-name> [-- <command...>]" >&2
    echo "  --code    OTP confirmation code (from user's phone)" >&2
    echo "  --approve Skip OTP check (for authorized scripts)" >&2
    echo "" >&2
    echo "Examples:" >&2
    echo "  secret-exec --code 482719 SSH_KEY -- ssh-add -" >&2
    echo "  secret-exec --code 935201 GITHUB_TOKEN -- gh auth login --with-token" >&2
    exit 1
}

# Remove optional --
[ "${1:-}" = "--" ] && shift

# ─── Validate OTP code ──────────────────────────────────────────────────────
if [ "$AUTO_APPROVE" = false ]; then
    [ -n "$CODE" ] || {
        echo "ERROR: --code <6-digit> is required. Ask user to generate it." >&2
        exit 1
    }
    [[ "$CODE" =~ ^[0-9]{6}$ ]] || {
        echo "ERROR: code must be 6 digits, got '$CODE'" >&2
        exit 1
    }

    VERIFY=$(sudo secrets-verify "$STORE_PATH" "$CODE" 2>&1 || echo "FAIL")
    if [ "$VERIFY" != "OK" ]; then
        echo "❌ ACCESS DENIED: wrong or expired code for '$STORE_PATH'" >&2
        exit 1
    fi
    echo "✅ CODE VERIFIED for '$STORE_PATH'" >&2
fi

# ─── Execute with secret ─────────────────────────────────────────────────────
if [ $# -gt 0 ]; then
    /usr/bin/pass show "$STORE_PATH" | "$@" 2>&1
    echo "(secret-exec) ✓ $*" >&2
else
    /usr/bin/pass show "$STORE_PATH"
fi
