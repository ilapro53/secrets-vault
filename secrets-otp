#!/usr/bin/env python3
# secrets-otp — generate OTP code
# Usage: secrets-otp [command]
#   Without args → standard TOTP (30s, matches authenticator app)
#   With arg    → command-bound code (10min window)
import sys, os, hmac, hashlib, time, struct

secret_file = "/root/.secrets-otp/totp-secret"
if not os.path.isfile(secret_file):
    print("ERROR: secret not found", file=sys.stderr)
    sys.exit(1)

with open(secret_file) as f:
    b32secret = f.read().strip()

if not b32secret:
    print("ERROR: empty secret", file=sys.stderr)
    sys.exit(1)

def b32decode(s):
    b32 = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"
    s = s.upper().strip()
    bits = "".join(format(b32.index(c), "05b") for c in s if c in b32)
    return bytes(int(bits[i*8:(i+1)*8], 2) for i in range(len(bits)//8))

key = b32decode(b32secret)

if len(sys.argv) == 1:
    # Standard TOTP — 30s, for phone authenticator compatibility
    tw = int(time.time()) // 30
    msg = struct.pack(">Q", tw)
    h = hmac.new(key, msg, hashlib.sha1).digest()
    off = h[-1] & 0xf
    code = (struct.unpack(">I", h[off:off+4])[0] & 0x7fffffff) % 1000000
    print(f"{code:06d}")
else:
    # Command-bound — 10 minute window (600 seconds)
    cmd = " ".join(sys.argv[1:])
    tw = int(time.time()) // 600
    msg = f"{cmd}|{tw}"
    h = hmac.new(key, msg.encode(), hashlib.sha1).digest()
    off = h[-1] & 0xf
    p = struct.unpack(">I", h[off:off+4])[0] & 0x7fffffff
    code = p % 1000000
    print(f"{code:06d}")
